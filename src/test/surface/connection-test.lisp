;;;; connection-test.lisp --- the footer's connection knob: the terms a host answers for, the
;;;; verdict a measured connection reads, one check a model pick, and the box it opens.
;;;; SPDX-License-Identifier: MIT
(in-package #:nodecode.test)

(defparameter +connection-tls+
  '(:tls "TLSv1.3" :group "X25519MLKEM768" :issuer "Google Trust Services" :cloudflare nil :proxy nil)
  "What a direct TLS 1.3 handshake with a post-quantum key exchange measures.")

(defun connection-row (verdict label)
  (find label (getf verdict :rows) :key #'second :test #'equal))

(deftest connection-terms-are-matched-on-the-host ()
  (flet ((name (host) (getf (nle::provider-terms host) :name)))
    (is (equal "NODECODE" (name "api.nodecode.ai")))
    (is (equal "Anthropic" (name "api.anthropic.com")))
    (is (equal "OpenAI" (name "eu.api.openai.com")) "a region under the host")
    (is (equal "Google Vertex" (name "europe-west4-aiplatform.googleapis.com")) "a glob's label")
    (is (equal "AWS Bedrock" (name "bedrock-runtime.eu-central-1.amazonaws.com")))
    (is (null (name "s3.eu-central-1.amazonaws.com")) "the same cloud, another service")
    (is (null (name "api.anthropic.com.example.net")) "a suffix only on a dot")
    (is (null (name "reseller.example")) "a host on no row is unknown")))

(deftest connection-reads-private-only-for-nodecodes-own-endpoint ()
  (let ((own (nle::connection-verdict "nodecode" (list* :host "api.nodecode.ai" +connection-tls+))))
    (is (eq :private (getf own :level)))
    (is (equal "Connection secure · Private" (getf own :label)))
    (is (equal '(:ok "Encrypted" "TLS 1.3 · PQC") (connection-row own "Encrypted")))
    (is (every (lambda (row) (member (first row) '(:ok nil))) (getf own :rows)) "every row ours to promise"))
  (let ((fronted (nle::connection-verdict "nodecode" (list* :host "api.nodecode.ai" :cloudflare t +connection-tls+))))
    (is (eq :not-private (getf fronted :level)) "Cloudflare in front reads the prompt too")))

(deftest connection-reads-a-providers-terms-as-their-word ()
  (let ((api (nle::connection-verdict "anthropic" (list* :host "api.anthropic.com" :cloudflare t +connection-tls+))))
    (is (eq :not-private (getf api :level)))
    (is (equal "Connection secure · Not private" (getf api :label)))
    (is (equal '(:no "Readable by" "Cloudflare · Anthropic") (connection-row api "Readable by")))
    (is (equal '(:no "Stored" "30 days") (connection-row api "Stored")))
    (is (equal '(:claim "Trained on" "no") (connection-row api "Trained on")) "a promise, never a check")
    (is (equal '(:no "ZDR" "enterprise") (connection-row api "ZDR"))))
  ;; A subscription reaching the same host signs a plan's terms, not the API's.
  (let ((plan (nle::connection-verdict "claude-code" (list* :host "api.anthropic.com" +connection-tls+))))
    (is (equal '(:no "Readable by" "Anthropic") (connection-row plan "Readable by")))
    (is (equal '(:no "Trained on" "unknown") (connection-row plan "Trained on")))))

(deftest connection-off-the-list-is-unknown-and-unsecure ()
  (let ((resold (nle::connection-verdict "openai" (list* :host "reseller.example" +connection-tls+))))
    (is (eq :unknown (getf resold :level)) "a provider's name on a host that is not its own")
    (is (equal "Unknown · Unsecure" (getf resold :label)))
    (is (equal '(:no "Readable by" "reseller.example") (connection-row resold "Readable by")))
    (is (equal '(nil "Source" "not on our list") (connection-row resold "Source"))))
  (is (eq :local (getf (nle::connection-verdict "ollama" '(:host "127.0.0.1" :local t)) :level)))
  (is (eq :plain (getf (nle::connection-verdict "x" '(:host "models.example" :plain t)) :level)))
  (is (eq :unchecked (getf (nle::connection-verdict "anthropic" '(:host "api.anthropic.com" :error "offline")) :level))))

(deftest connection-is-measured-once-a-model-pick (with-temp-store ())
  (let ((nle::*connection-checks* (make-hash-table :test #'equal))
        (model (make-frame-model 110 40))
        (pick (list "nodecode" "nodecode/cyber-v1"))
        (probes '()))
    (with-stubbed-fdefinitions ((nle::footer-identity (model) (declare (ignore model))
                                  (values (first pick) (second pick) :configured))
                                (nle::connection-endpoint (provider model) (declare (ignore model))
                                  (if (equal provider "nodecode") "https://api.nodecode.ai/v1/chat/completions"
                                      "https://api.anthropic.com/v1/messages"))
                                (nle::connection-probe (url &key timeout) (declare (ignore timeout))
                                  (push url probes)
                                  (list* :host (quri:uri-host (quri:uri url)) +connection-tls+)))
      (nle::check-connection model)
      (nle::check-connection model)
      (is (= 1 (length probes)) "a second look at the same pick measures nothing")
      (let ((knob (first (nle::connection-knob-segs model))))
        (is (equal "● Connection secure · Private" (nle::seg-text knob)))
        (is (eq :success (nle::seg-tone knob)) "green: NODECODE's own")
        (is (equal '(:command . "privacy") (nle::seg-link knob))))
      (setf pick (list "anthropic" "anthropic/claude-opus-5-5"))
      (nle::check-connection model)
      (is (= 2 (length probes)) "another model is measured once more")
      (is (eq :connection (nle::seg-tone (first (nle::connection-knob-segs model)))) "light blue otherwise")
      (nle::execute-slash-command model "privacy" "")
      (let* ((dialog (nle::chat-model-dialog model))
             (labels (mapcar #'nle::picker-row-label (nle::picker-dialog-rows dialog))))
        (is (eq :privacy (nle::picker-dialog-kind dialog)))
        (is (equal "privacy" (nle::picker-dialog-command :privacy)) "a second click on the knob closes it")
        (is (equal "anthropic/claude-opus-5-5 · Anthropic" (first labels)))
        (is (equal "Connection secure · Not private" (second labels)))
        (is (some (lambda (label) (search "✓ Encrypted" label)) labels) "the facts as pills")
        (is (>= (nle::docked-dialog-frame-rows model) (length labels)) "the box is read whole, never scrolled")))))

(deftest connection-pills-stack-a-blank-line-apart ()
  ;; Asked 2026-10-26: "keep pills", "separated vertically (one line gap)", then "half and half
  ;; colored" like the footer's nodecode.ai badge.
  (let ((check (nle::connection-verdict "anthropic" (list* :host "api.anthropic.com" :cloudflare t +connection-tls+)))
        (key '("anthropic" . "anthropic/claude-opus-5-5")))
    (flet ((rows (room) (nle::connection-dialog-rows key check room)))
      (let* ((rows (rows 400))
             (start (position-if #'nle::picker-row-paint rows))
             (pills (remove-if-not #'nle::picker-row-paint rows))
             (facts (count-if #'first (getf check :rows))))
        (is (= facts (length pills)) "one pill a fact, however wide the panel")
        (let ((stack (subseq rows start (+ start (1- (* 2 facts))))))
          (is (loop for row in stack for pill = t then (not pill) always (if pill (nle::picker-row-paint row) (equal "" (nle::picker-row-label row)))) "a blank line between each two pills"))
        (is (notany (lambda (row) (search "│" (nle::picker-row-label row))) pills) "no dividers in a pill")
        (is (some (lambda (row) (search "✗ Readable by" (nle::picker-row-label row))) pills))
        (let* ((nle::*color-profile* :truecolor)
               (painted (mapcar (lambda (row) (rest (funcall (nle::picker-row-paint row) nil 0)))
                                (remove-if-not #'nle::picker-row-paint (rows 400))))
               (grey (nle::visual-style-bg (nle::style-for-tone :sheet-chip))))
          (is (every (lambda (pill) (= 2 (length pill))) painted) "a pill is two halves")
          (is (every (lambda (pill) (equal grey (nle::visual-style-bg (nle::seg-ground (first pill))))) painted) "what it checks on the chip grey")
          (is (equal (nle::visual-style-fg (nle::style-for-tone :danger)) (nle::visual-style-bg (nle::seg-ground (second (third painted))))) "a red fact's value on red")
          (is (= 1 (length (remove-duplicates (mapcar (lambda (pill) (nle::segs-display-width (list (first pill)))) painted)))) "the halves split in one column down the stack"))
        (is (every (lambda (row) (<= (nle::segs-display-width (funcall (nle::picker-row-paint row) nil 0)) 40)) (remove-if-not #'nle::picker-row-paint (rows 40))) "no pill runs past the panel")))))

(deftest connection-knob-leads-the-footers-right-lane (with-temp-store ())
  (let ((nle::*connection-checks* (make-hash-table :test #'equal))
        (model (make-frame-model 110 40)))
    (with-stubbed-fdefinition (nle::footer-identity (model) (declare (ignore model))
                                (values "nodecode" "nodecode/cyber-v1" :configured))
      (is (notany (lambda (candidate) (find '(:command . "privacy") candidate :key #'nle::seg-link :test #'equal)) (nle::footer-right-candidates model)) "no knob before the pick is measured")
      (setf (gethash '("nodecode" . "nodecode/cyber-v1") nle::*connection-checks*) :checking)
      (let ((candidates (nle::footer-right-candidates model)))
        (is (every (lambda (candidate) (equal "◌ Checking connection…" (nle::seg-text (first candidate)))) candidates) "it leads every candidate and is the last one standing")
        (is (= 1 (length (car (last candidates)))))))))
